# Copia in .env:  cp .env.example .env
# Solo le variabili con prefisso VITE_ arrivano al browser.
# Non metterci mai segreti: finiscono nel bundle, visibili a chiunque.

# URL del backend Django.
VITE_API_URL=http://localhost:8000

# Client ID OAuth di Google — lo stesso valore di GOOGLE_CLIENT_ID nel .env
# alla radice. È un identificativo pubblico, pensato per stare nel browser.
# Lasciandolo vuoto il pulsante "Continua con Google" viene nascosto.
VITE_GOOGLE_CLIENT_ID=
