# Copia questo file in .env e completa i valori.
#   cp .env.example .env
# Il .env NON va committato (è già in .gitignore).

# ---------------------------------------------------------------- Django core
# Genera una chiave con:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=cambia-questa-chiave-in-produzione

# In produzione deve restare False.
DEBUG=True

# Elenco separato da virgole. In produzione: askyvet.it,www.askyvet.it
ALLOWED_HOSTS=localhost,127.0.0.1

# ------------------------------------------------------------------- Database
DB_NAME=askyvet_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Da lasciare com'è. Serve solo per far girare i test senza un PostgreSQL attivo:
#   DB_ENGINE=django.db.backends.sqlite3
DB_ENGINE=django.db.backends.postgresql

# ----------------------------------------------------------------------- CORS
# Origini del frontend React autorizzate a chiamare l'API.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --------------------------------------------------------------- Google OAuth
# Senza CLIENT_ID il login con Google resta disattivato, il resto funziona.
# Il CLIENT_SECRET serve solo per il flusso "authorization code": con il flusso
# a token usato dal frontend basta il CLIENT_ID.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ----------------------------------------------------------------- Rate limit
# Formato DRF: "<numero>/<periodo>" con periodo in sec|min|hour|day.
THROTTLE_ANON=60/min
THROTTLE_USER=240/min
THROTTLE_AUTH=10/min

# ---------------------------------------------------------------------- Email
# "none" in sviluppo, "mandatory" in produzione quando l'invio email è attivo.
ACCOUNT_EMAIL_VERIFICATION=none
